
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    @* <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/css/bootstrap.min.css" rel="stylesheet" /> *@

    @* Start Header *@
    <header>
        <center>
            <nav class="mt-5">
                <a href="/Home/Index" class="btn btn-primary m-2">Home</a>
                <a href="/Home/Privacy" class="btn btn-warning m-2">Privacy</a>
                <a href="/Home/ContactUs" class="btn btn-success m-2">Contact Us</a>
                <a href="/Home/AboutUs" class="btn btn-secondary m-2">About Us</a>
            </nav>
        </center>
    </header>
    @*End Header *@

    @* Start Body *@
    <section>
        <center>
            <div class="mt-2 p-5 bg-primary w-75">
                <h1>Welcome To Home</h1>
                <p>Route Academy</p>
            </div>
        </center>
    </section>
    @* End Body *@

    @* Start Footer *@
    <footer>
        <center>
            <div class=" mt-2">
                <p>CopyRights &copy; Route @DateTime.Now.Year</p>
            </div>
        </center>
    </footer>
    @* End Footer *@
